# Copy to .env (git-ignored) and fill in. See src/harness/README.md.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Either a path to the downloaded .pem (recommended) ...
GITHUB_APP_PRIVATE_KEY_PATH=./geo-app.private-key.pem
# ... or the PEM inline with literal \n for newlines:
# GITHUB_APP_PRIVATE_KEY=
PORT=3000
# GEO_DATA_DIR=data/harness
