{
  "name": "aperture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Aperture — GEO control layer. React front end over the URL diagnostics + proxy engine.",
  "bin": {
    "aperture": "cli/aperture.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scan": "node cli/aperture.js",
    "start": "tsx server/bridge.ts",
    "bridge": "tsx server/bridge.ts",
    "demo": "tsx src/runDiagnostics.ts",
    "demo:proxy": "tsx src/runProxyDemo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "cheerio": "^1.0.0",
    "gsap": "^3.12.5",
    "jszip": "^3.10.2",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
